# LLM provider: "anthropic" (default) or "openai" (any OpenAI-compatible endpoint, incl. Azure OpenAI /openai/v1)
LLM_PROVIDER=anthropic

# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_BASE_URL=

# --- OpenAI / Azure OpenAI ---
# OPENAI_BASE_URL=https://<resource>.openai.azure.com/openai/v1
# OPENAI_API_KEY=

# Model used by every stage (defaults: claude-sonnet-5-5 for anthropic, gpt-5.4 for openai)
# AGENT_MODEL=claude-sonnet-5-5

# Optional: real Jira. Leave JIRA_BASE_URL empty to use the repo's mock tickets.
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
